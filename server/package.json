{
  "name": "moyu-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "玄门诡事录 · Node/TS 后端（cordis 插件内核）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
