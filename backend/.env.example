# 默认 SQLite（backend/data/moyu.db），开箱即用。
# 换 PostgreSQL：
#   MOYU_DATABASE_URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/moyu_trpg
# 换 MySQL（另需装 asyncmy）：
#   MOYU_DATABASE_URL=mysql+asyncmy://root:123456@127.0.0.1:3306/moyu_trpg
MOYU_DATABASE_URL=sqlite+aiosqlite:///./data/moyu.db
MOYU_HOST=127.0.0.1
MOYU_PORT=8770
MOYU_AUTO_CREATE_TABLES=false
